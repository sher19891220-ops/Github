# ── Required ──────────────────────────────────────────────────────────────────

# Claude API (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram bot token (get from @BotFather) + your Telegram chat ID
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Security: protects the /chat endpoint — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=generate_a_strong_random_key_here

# ── Server ────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8000

# ── Claude model ──────────────────────────────────────────────────────────────

CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=8192
MAX_TOOL_ITERATIONS=25

# ── Database ──────────────────────────────────────────────────────────────────

DB_PATH=jarvis.db

# ── Shell safety ──────────────────────────────────────────────────────────────

ALLOW_SHELL=true
# Restrict shell to specific paths (comma-separated). Empty = unrestricted.
# ALLOWED_SHELL_PATHS=/Users/sher/projects,/Users/sher/scripts

# ── Timezone (for calendar events) ───────────────────────────────────────────

TIMEZONE=America/Los_Angeles

# ── Google Workspace (Gmail, Drive, Sheets, Calendar) ────────────────────────
# Setup: python setup_google_auth.py  (needs credentials.json in this dir first)
# Get credentials.json from: console.cloud.google.com → APIs → OAuth 2.0 Client ID → Desktop app
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ── Microsoft Outlook ────────────────────────────────────────────────────────
# Setup: python setup_microsoft_auth.py
# Get client ID from: portal.azure.com → App registrations → New
# For personal Outlook.com use: MS_TENANT_ID=consumers
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=consumers
MS_TOKEN_PATH=ms_token.json

# ── Plaid (bank accounts) ────────────────────────────────────────────────────
# Setup: python setup_plaid.py
# Get credentials from: dashboard.plaid.com → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# Comma-separated if you have multiple banks
PLAID_ACCESS_TOKENS=

# ── QuickBooks ────────────────────────────────────────────────────────────────
# Setup: python setup_quickbooks.py
# Get credentials from: developer.intuit.com → My Apps
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REALM_ID=
QB_ACCESS_TOKEN=
QB_REFRESH_TOKEN=
