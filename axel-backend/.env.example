# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_TOKEN=...
TELEGRAM_CHAT_ID=...

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=

# ── Deploy webhook ────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DEPLOY_SECRET=
# Your Mac mini IP or Tailscale hostname
AXEL_URL=http://192.168.1.100:8000

# ── AI Memory — Mem0 (app.mem0.ai → Settings → API Keys) ─────────────────────
# Free tier: 1,000 memories. Falls back to local SQLite if blank.
MEM0_API_KEY=m0-...

# ── Web Research — Firecrawl (firecrawl.dev → API Keys) ──────────────────────
# Free tier: 500 scrapes/month. Falls back to httpx+BeautifulSoup if blank.
FIRECRAWL_API_KEY=fc-...

# ── Social Media — Composio (composio.io → Settings → API Keys) ──────────────
# Required for: Instagram, LinkedIn, Twitter/X, WhatsApp via Axel
COMPOSIO_API_KEY=

# ── Google Workspace (Gmail, Sheets, Calendar, Drive) ─────────────────────────
# Run: python setup_google_auth.py  (needs credentials.json downloaded from GCP)
GOOGLE_TOKEN_PATH=token.json

# ── Microsoft / Outlook ───────────────────────────────────────────────────────
# Run: python setup_microsoft_auth.py
MS_CLIENT_ID=
MS_TOKEN_PATH=ms_token.json

# ── Bank accounts — Plaid (dashboard.plaid.com) ───────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKENS=...  # comma-separated if multiple accounts

# ── QuickBooks (developer.intuit.com) ─────────────────────────────────────────
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REALM_ID=
QB_ACCESS_TOKEN=
QB_REFRESH_TOKEN=

# ── Optional overrides ────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-sonnet-4-5
# HOST=0.0.0.0
# PORT=8000
# DB_PATH=axel.db
# ALLOW_SHELL=true
