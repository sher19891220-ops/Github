# App
NEXT_PUBLIC_APP_URL=https://pti.zonellc.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/pti_db

# Authentication
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=https://pti.zonellc.com

# Telegram Bot (@Pti_check_bot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_dispatch_group_chat_id

# Cloud Storage (S3-compatible)
STORAGE_BUCKET=pti-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_key
STORAGE_SECRET_KEY=your_secret

# Optional: Telegram webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
