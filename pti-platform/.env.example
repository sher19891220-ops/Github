# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://pti.zonellc.com

# PostgreSQL — required for production, skip for local mock-data dev
DATABASE_URL=postgresql://user:password@localhost:5432/pti_db

# Telegram Bot (@Pti_check_bot)
# Get your token from @BotFather
TELEGRAM_BOT_TOKEN=8818097343:AAE_v_5QZaTOzd08fmp5yZej3aJ8TNN6vfU

# Chat ID for dispatch notifications (group or channel)
# Find it by sending a message to @userinfobot or checking the API
TELEGRAM_DISPATCH_CHAT_ID=your_dispatch_group_chat_id

# Protects the /api/bot/setup endpoint — set to any random string
BOT_SETUP_KEY=change-me-random-string

# Cloud Storage — S3-compatible (AWS, Cloudflare R2, etc.)
STORAGE_BUCKET=pti-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
