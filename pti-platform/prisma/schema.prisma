// PTI Inspection Platform - PostgreSQL Schema
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Driver {
  id             String       @id @default(cuid())
  name           String
  licenseNumber  String       @unique
  company        Company
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  inspections    Inspection[]
  sessions       Session[]

  @@index([company])
  @@map("drivers")
}

model Vehicle {
  id             String       @id @default(cuid())
  unitNumber     String       @unique
  plateNumber    String
  make           String
  model          String
  year           Int
  company        Company
  trailerNumber  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  inspections    Inspection[]
  sessions       Session[]

  @@index([company])
  @@map("vehicles")
}

model Session {
  id          String         @id @default(cuid())
  token       String         @unique
  type        InspectionType
  driver      Driver         @relation(fields: [driverId], references: [id])
  driverId    String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  vehicleId   String
  expiresAt   DateTime
  used        Boolean        @default(false)
  inspection  Inspection?
  createdAt   DateTime       @default(now())

  @@index([token])
  @@index([driverId])
  @@map("sessions")
}

model Inspection {
  id              String            @id @default(cuid())
  sessionToken    String            @unique
  session         Session           @relation(fields: [sessionToken], references: [token])
  type            InspectionType
  status          InspectionStatus  @default(SUBMITTED)
  driver          Driver            @relation(fields: [driverId], references: [id])
  driverId        String
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])
  vehicleId       String
  odometer        Int
  fuelLevel       Float
  gpsLat          Float?
  gpsLng          Float?
  gpsAccuracy     Float?
  gpsAddress      String?
  signatureUrl    String?
  pdfUrl          String?
  telegramMsgId   String?
  failCount       Int               @default(0)
  photoCount      Int               @default(0)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  photos          InspectionPhoto[]
  checklistItems  ChecklistItem[]
  damageMarkers   DamageMarker[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("inspections")
}

model InspectionPhoto {
  id           String     @id @default(cuid())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  angle        String
  angleLabel   String
  storageKey   String
  url          String
  blurScore    Float?
  passed       Boolean    @default(true)
  capturedAt   DateTime
  createdAt    DateTime   @default(now())

  @@index([inspectionId])
  @@map("inspection_photos")
}

model ChecklistItem {
  id           String     @id @default(cuid())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  category     String
  label        String
  mandatory    Boolean
  status       ItemStatus @default(PENDING)
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([inspectionId])
  @@map("checklist_items")
}

model DamageMarker {
  id           String     @id @default(cuid())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  x            Float
  y            Float
  view         String
  description  String
  severity     String
  createdAt    DateTime   @default(now())

  @@index([inspectionId])
  @@map("damage_markers")
}

enum Company {
  ZONE_LLC
  XTRACK_LLC
  AFG_TRANSPORTCO
}

enum InspectionType {
  PICKUP
  DROP_OFF
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  REVIEWED
}

enum ItemStatus {
  PASS
  FAIL
  NA
  PENDING
}
