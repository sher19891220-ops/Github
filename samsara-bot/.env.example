# ---- Samsara -------------------------------------------------------------
# API token from Samsara: Settings > Organization > API Tokens.
# Needs read scopes for Vehicles, Drivers, Safety Events, DVIRs and HOS.
SAMSARA_API_TOKEN=

# EU-hosted organisations: https://api.eu.samsara.com
SAMSARA_API_BASE=https://api.samsara.com

# Shared secret configured on the Samsara webhook. Strongly recommended:
# without it the webhook endpoint accepts unsigned POSTs from anyone.
SAMSARA_WEBHOOK_SECRET=

# ---- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Channel or group the alerts go to (channels look like -1001234567890).
TELEGRAM_CHAT_ID=

# Optional forum topic in that group to post every alert into.
TELEGRAM_TOPIC_ID=

# Random string; Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Per-unit fan-out. JSON object mapping a Samsara vehicle ID *or* vehicle name
# to that unit's Telegram group. Every event goes to TELEGRAM_CHAT_ID above and,
# when the unit is mapped here, to its own group as well. Keys are matched
# case- and space-insensitively ("Truck 12" == "truck12").
# Keys may be the unit number, plate, vehicle name or Samsara vehicle ID — for a
# label like "5269 (GZP5W69Z75) 281474991641331" all three are matched.
# A value may be a bare chat ID, or "chatId:topicId" to post into a forum topic.
# UNIT_CHAT_MAP={"5269":"-1001111111111","1645":"-1002922384236:42"}
UNIT_CHAT_MAP=

# Forward Samsara clips into Telegram. Set false to send links only.
SEND_VIDEOS=true

# Optional comma-separated Telegram user IDs allowed to run commands.
# Leave empty to let anyone in the chat use the bot. /whoami prints your ID.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Endpoint protection -------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
CRON_SECRET=
# Lets you call cron/setup endpoints by hand with ?secret=...
ADMIN_SECRET=

# ---- Behaviour -----------------------------------------------------------
FLEET_TIMEZONE=America/Chicago

# Comma-separated allow-list of behaviour keys; empty means every behaviour.
# Keys: crash, rollover, panicButton, forwardCollisionWarning, mobileUsage,
#       distractedDriving, drowsy, noSeatbelt, severeSpeeding, hosViolation,
#       speeding, unassignedDriving, harshBrake, harshAccel, harshTurn,
#       rollingStop, tailgating, laneDeparture, engineFault, dvirDefect,
#       smoking, geofence
ALERT_BEHAVIORS=

# low | medium | high | critical
ALERT_MIN_SEVERITY=low

# Poll window for /api/cron/safety when no watermark is stored.
SAFETY_LOOKBACK_MINUTES=15

# How long an alert fingerprint suppresses duplicates.
ALERT_DEDUPE_TTL_SECONDS=86400

# ---- Optional persistence (Upstash Redis / Vercel KV) --------------------
# Without these, de-duplication is per-instance and duplicates can slip through.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
