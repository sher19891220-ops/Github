# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram (bot token + Sher's chat ID for proactive messages)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Security: random string to protect the backend endpoint
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=generate_a_strong_random_key_here

# Server
HOST=0.0.0.0
PORT=8000

# Optional
CLAUDE_MODEL=claude-sonnet-4-5
MAX_TOKENS=8192
MAX_TOOL_ITERATIONS=25
DB_PATH=jarvis.db

# Shell safety (set to false to disable shell execution)
ALLOW_SHELL=true

# Restrict shell to these paths only (comma-separated, empty = unrestricted)
# ALLOWED_SHELL_PATHS=/Users/sher/projects,/Users/sher/scripts
